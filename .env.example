# ---- Required ----
# Key used to encrypt provider credentials at rest (any strong random string).
ITNOTICE_ENCRYPTION_KEY=replace-with-a-long-random-string

# ---- Database ----
POSTGRES_USER=itnotice
POSTGRES_PASSWORD=itnotice
POSTGRES_DB=itnotice
# Used when running the API outside docker-compose:
# DATABASE_URL=postgres://itnotice:itnotice@localhost:5432/itnotice

# ---- Authentication (any OIDC provider works; Keycloak is the bundled default) ----
# Issuer as seen by the API (docker network hostname inside compose).
OIDC_ISSUER_URL=http://keycloak:8080/realms/itnotice
# Dot-path to roles array in access tokens. Keycloak default shown; adjust for your IdP.
OIDC_ROLES_CLAIM=realm_access.roles
# Optional audience check:
# OIDC_AUDIENCE=itnotice-web
# Local development without an IdP (grants an all-role dev user):
AUTH_DISABLED=false

# ---- Bundled Keycloak (dev defaults; change for production) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=itnotice
KEYCLOAK_SYNC_CLIENT_ID=itnotice-sync
KEYCLOAK_SYNC_CLIENT_SECRET=change-me-sync-secret
DIRECTORY_SYNC_INTERVAL_MINUTES=60

# ---- Web app (build-time) ----
VITE_API_URL=http://localhost:4000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/itnotice
VITE_OIDC_CLIENT_ID=itnotice-web
VITE_APP_NAME=ITNotice

# ---- API ----
PORT=4000
CORS_ORIGIN=http://localhost:5173
