FROM node:20-alpine

ARG VITE_API_URL=http://localhost:4000
ARG VITE_OIDC_AUTHORITY=http://localhost:8080/realms/itnotice
ARG VITE_OIDC_CLIENT_ID=itnotice-web
ARG VITE_APP_NAME=ITNotice
ENV VITE_API_URL=$VITE_API_URL \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_APP_NAME=$VITE_APP_NAME

WORKDIR /app
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/
RUN npm install

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
RUN npm run build --workspace @itnotice/shared && npm run build --workspace @itnotice/web

EXPOSE 5173
CMD ["npm", "run", "preview", "--workspace", "@itnotice/web", "--", "--host", "0.0.0.0", "--port", "5173"]
